    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json; const allowed = ['Admissional', 'Periódico', 'Retorno ao trabalho', 'Mudança de função', 'Demissional']; if (typeof body.externalId !== 'string' || !/^DEMO-[A-Z0-9-]{3,40}$/.test(body.externalId)) throw new Error('Use um externalId fictício iniciando com DEMO-'); if (!allowed.includes(body.examType)) throw new Error('Tipo de exame inválido'); if (typeof body.unit !== 'string' || !body.unit.trim()) throw new Error('Informe uma unidade fictícia'); if (!Array.isArray(body.exams) || !body.exams.length) throw new Error('Informe exames de exemplo'); return [{ json: { externalId: body.externalId, examType: body.examType, unit: body.unit, exams: body.exams } }];"
      },
      "id": "demo-normalize",
      "name": "Code - Validar evento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 280]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-DEMO-DOMAIN.example/api/integration-preview",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "demo-http",
      "name": "HTTP - Simular integração",
